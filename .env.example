# Used by docker-compose.yml at the repo root - Docker Compose reads
# .env from the SAME directory as docker-compose.yml, not from
# backend/.env or frontend/.env (those are for running the backend/
# frontend directly, outside Docker).
#
# Copy this to .env before running `docker compose up`.

DB_PASSWORD=changeme

# Generate a real secret: openssl rand -hex 32
JWT_SECRET=

# Where Person 2's Python AI service is running. Leave the default if
# it's not up yet - AIClientService degrades to REVIEW/flag-for-review
# rather than failing hard.
AI_SERVICE_BASE_URL=http://ai-service:9000