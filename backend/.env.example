# Copy this file to .env and fill in real values.
# main.cpp reads these via Config::loadFromEnv() at startup.
# Never commit the real .env file - only this .example file goes in git.

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=merchantra
DB_USER=merchantra
DB_PASSWORD=changeme

# Auth
# Generate a real random secret, e.g.: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRY_MINUTES=60

# Python AI service (Person 2) - backend calls this, frontend never does
AI_SERVICE_BASE_URL=http://localhost:9000